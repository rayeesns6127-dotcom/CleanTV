<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingTop="24dp" android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingBottom="8dp">

    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="end|center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/icBt" style="@style/TopIcon" android:src="@drawable/ic_bluetooth" android:contentDescription="Bluetooth" />
        <ImageView android:id="@+id/icWifi" style="@style/TopIcon" android:src="@drawable/ic_wifi" android:contentDescription="Network" />
        <ImageView android:id="@+id/icSettings" style="@style/TopIcon" android:src="@drawable/ic_settings" android:contentDescription="Settings" />
        <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textSize="32sp" android:textColor="#FFFFFF" android:layout_marginStart="10dp" />
        <LinearLayout android:id="@+id/dateBox" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="10dp">
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="EEEE" android:format24Hour="EEEE" android:textSize="12sp" android:textColor="#C8CCD4" />
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="d MMM yyyy" android:format24Hour="d MMM yyyy" android:textSize="12sp" android:textColor="#C8CCD4" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/weather" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="28dp" android:layout_marginStart="32dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/wIcon" android:layout_width="72dp" android:layout_height="72dp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                <TextView android:id="@+id/wTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="52sp" android:textStyle="bold" android:textColor="#8AD1F0" />
                <TextView android:id="@+id/wCity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" />
                <TextView android:id="@+id/wCond" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#C8CCD4" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="40dp">
                <TextView android:id="@+id/wHum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFF" android:layout_marginBottom="6dp" />
                <TextView android:id="@+id/wWind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFF" android:layout_marginBottom="6dp" />
                <TextView android:id="@+id/wFeels" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="380dp" android:layout_height="1dp" android:background="#55FFFFFF" android:layout_marginTop="14dp" android:layout_marginBottom="10dp" />
        <LinearLayout android:id="@+id/forecast" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="12dp" android:clipToPadding="false" android:paddingTop="12dp" android:paddingBottom="12dp" />
</LinearLayout>
